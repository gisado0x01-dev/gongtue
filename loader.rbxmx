local notificationModule = script:FindFirstChildOfClass("ModuleScript")
local notificationResult
if notificationModule then
	local requireSuccess, result = pcall(require, notificationModule)
	if requireSuccess and type(result) == "table" and type(result.Notify) == "function" then
		notificationResult = result
	end
end

local function safeNotify(icon, title, message, duration)
	if notificationResult and type(notificationResult.Notify) == "function" then
		local success = pcall(notificationResult.Notify, icon, title, message, duration)
		if success then
			return
		end
	end
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = tostring(title or "알림"),
			Text = tostring(message or ""),
			Duration = tonumber(duration) or 3
		})
	end)
end
